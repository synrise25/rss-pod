# PostgreSQL
DATABASE_HOST=127.0.0.1
DATABASE_USER=rsspod
DATABASE_PASSWORD=change-me

# S3-compatible storage (for example, MinIO)
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:9000/rsspod-media

# Content extraction
JINA_API_KEY=
JINA_PROXY=

CRAWL4AI_BASE_URL=
CRAWL4AI_API_TOKEN=
CRAWL4AI_PROXY=

# OpenAI-compatible LLM providers
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_DEEPSEEK_API_KEY=change-me
LLM_DEEPSEEK_MODEL=deepseek-chat
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_GEMINI_API_KEY=change-me
LLM_GEMINI_MODEL=gemini-2.5-flash

# Text to speech
EDGE_TTS_PROXY=
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_KEY=change-me
AZURE_SPEECH_PROXY=

# Optional admin UI; empty secret disables all admin routes.
# 可选管理员页面；密钥为空时关闭所有管理员路由。
RSS_POD_ADMIN_TOTP_SECRET=

# Jev screening: base URL excludes /systemone; timeout belongs in YAML.
# Jev 筛选：基础地址不含 /systemone；超时在 YAML 中配置。
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
